<Window x:Class="LiveWallpaper.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Show — Setup &amp; Settings"
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Live Show" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Set smooth live video wallpapers behind desktop icons" FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Settings Cards -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Video Selection Card -->
            <Border Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#3F3F46" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Wallpaper Video" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    <TextBlock x:Name="TxtVideoPath" Text="No video selected" FontSize="11" Foreground="#A1A1AA" Margin="0,6,0,10" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnBrowse" Content="Choose Video…" Click="BtnBrowse_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Display Topology Info -->
            <Border Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#3F3F46" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Connected Displays" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    <TextBlock x:Name="TxtDisplays" Text="Detecting displays…" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,8"/>
                    <CheckBox x:Name="ChkApplyToAll" Content="Apply wallpaper to all monitors" IsChecked="True" Foreground="#D4D4D8" FontSize="12" Checked="ChkApplyToAll_Changed" Unchecked="ChkApplyToAll_Changed"/>
                </StackPanel>
            </Border>

            <!-- Startup & System Options -->
            <Border Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,8" BorderBrush="#3F3F46" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="System Options" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                    <CheckBox x:Name="ChkStartWithWindows" Content="Start Live Show automatically with Windows" Margin="0,6,0,0" Foreground="#D4D4D8" FontSize="12" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="BtnOpenLogs" Content="Open Logs" Click="BtnOpenLogs_Click" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="#A1A1AA"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close" Click="BtnClose_Click" Margin="0,0,8,0" Background="#3F3F46"/>
                <Button x:Name="BtnApply" Content="Apply &amp; Embed" Click="BtnApply_Click" Background="#2563EB" BorderBrush="#1D4ED8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
